{
  "schemaVersion": 1,
  "id": "bright",
  "version": "${version}",
  "name": "Bright",
  "description": "Lightweight PvP client mod: Hitbox, TriggerBot and ESP with in-game settings.",
  "authors": ["Yukile"],
  "environment": "client",

  "icon": "icon.png",

  "entrypoints": {
    "client": [
      "exloran.bright.Bright"
    ],
    "modmenu": [
      "exloran.bright.ModMenuIntegration"
    ]
  },

  "mixins": [
    "bright.mixins.json"
  ],

  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "1.20.1",
    "fabric-api": "*",
    "modmenu": "*",
    "java": ">=17"
  }
}
